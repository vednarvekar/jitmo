# ---- build output and dependencies ----
target/
node_modules/
app/dist/
app/src-tauri/gen/
*.log

# ---- Python environments and caches (spikes, tools) ----
.venv/
venv/
__pycache__/
hf_cache/
ft_out/
tools/router/.cache/

# ---- model files: large, fetched or trained locally ----
models/
adapters/
*.gguf
*.onnx
*.safetensors
*.bin
# The trained router head is small and committed; the encoder files are fetched
# (see models-src/router/README.md).
!models-src/
!models-src/**
models-src/**/*.onnx

# ---- spike results and local-only notes ----
spikes/**/results/
docs-backup-*/
docs/_archive/

# ---- editor, OS and agent working files ----
.vscode/
.claude/
*Zone.Identifier

# end-to-end test output (screenshots, traces)
app/e2e-results/
app/test-results/
