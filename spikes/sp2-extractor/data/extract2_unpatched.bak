"""SP2: pull names, files, times and more out of casual requests.

GLiNER (zero-shot) finds most span types. Simple rules handle dates, times,
durations and numbers, as doc 6.1 proposes. Label wording, model and threshold
are chosen on val only. doc4 (T01-T64) is scored once at the end.
"""
import os
os.environ.setdefault("OMP_NUM_THREADS","4")
import re
import psutil
import sys
import time
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).parent
BR = re.compile(r"\[(\w+)\|(.*?)\]")

# ---------- data ----------

def load(name):
    rows = []
    for line in (ROOT / "data" / name).read_text(encoding="utf-8").splitlines():
        rid, ann = line.split("|", 1)
        gold = [(m.group(1), m.group(2)) for m in BR.finditer(ann)]
        rows.append((rid, BR.sub(lambda m: m.group(2), ann), gold))
    return rows


def norm(s):
    s = s.lower().strip(" .?!,")
    s = re.sub(r"'s$", "", s)
    s = re.sub(r"^(?:at|on|the|my|this|these|that|a|an|some|for)\s+", "", s)
    s = re.sub(r"^(?:at|on|the|my|this|these|that|a|an|some|for)\s+", "", s)
    return s.strip()


# ---------- rules ----------

WD = r"(?:mon|tues?|wed(?:nes)?|thu(?:rs?)?|fri|sat(?:ur)?|sun)(?:day)?"
DAY = (rf"(?:today|tonight|tomorrow|tmrw|tmr|yesterday|(?:this|next|last)\s+(?:week|month|weekend|year|morning|afternoon|evening|night|{WD})"
       rf"|{WD})")
PART = r"(?:morning|afternoon|evening|night)"
TIME = r"(?:\d{1,2}(?::\d{2})?\s?(?:am|pm)|noon|midnight|\d{1,2}:\d{2})"
DATE_RE = re.compile(rf"\b\d{{1,2}}\s+(?:tomorrow|tmrw|today|tonight)\b|\b{DAY}(?:\s+{PART})?(?:\s+(?:at\s+)?{TIME})?\b|\b(?:at\s+)?{TIME}\b|\bat\s+\d{{1,2}}\b", re.I)
NUMW = r"(?:\d+(?:\.\d+)?|an?|one|two|three|four|five|six|seven|eight|nine|ten|fifteen|twenty|thirty|forty|forty[- ]five|sixty)"
DUR_RE = re.compile(rf"\b(?:half an hour|{NUMW}[ -]?(?:minutes?|mins?|hours?|hrs?|seconds?|secs?))\b", re.I)
NUM_RE = re.compile(r"\b\d+(?:\.\d+)?\s?(?:%|percent)|\b\d{1,3}(?:,\d{3})+\b|\b\d{3,}\b", re.I)


APPS = ["spotify", "youtube", "whatsapp", "teams", "chrome", "excel", "word", "powerpoint", "notepad", "outlook",
        "calculator", "vs code", "edge", "gmail", "drive", "onedrive"]
SITES = ["amazon", "netflix", "github", "linkedin", "wikipedia", "flipkart", "reddit", "google", "facebook", "twitter"]
SETTINGS = ["do not disturb", "volume", "brightness", "bluetooth", "wi-fi", "wifi", "do not disturb", "don't disturb", "dnd", "notifications",
            "sound", "airplane mode"]
EXT = r"(?:pdf|docx?|xlsx?|pptx?|txt|csv|png|jpe?g|zip)"
FILE_EXT = re.compile(rf"\b(?:(?:my|the|a|an|this|that)\s+(?:[\w-]+\s+)?)?[\w-]+\.{EXT}\b", re.I)
FILE_NOUN = r"(?:sheet|deck|report|resume|cv|contract|proposal|invoices?|document|pdfs?|photos?|screenshots?|receipts?|letter|thing|ticket|agreement|attachments?|notes|slides|spreadsheet|file|files)"
FILE_NP = re.compile(rf"\b(?:the|my|that|these|this)\s+(?:[\w-]+\s+){{0,2}}?{FILE_NOUN}\b", re.I)
FOLDER_CAP = re.compile(r"\b(?:to|into)\s+(?:the\s+)?([A-Z][\w-]+)(?:\s+folder)?\b")
FOLDER_NP = re.compile(r"\bthe\s+([\w-]+)\s+folder\b", re.I)
MSG_AFTER = re.compile(r"\b(?:saying|say|says|that|:)\s+(.+?)[.?!]*$", re.I)
MSG_AFTER_APP = re.compile(r"\bon\s+(?:whatsapp|teams)\s+(.+?)[.?!]*$", re.I)


def gazetteer(text, words, kind):
    out = []
    for w in words:
        for m in re.finditer(rf"(?<![\w-]){re.escape(w)}(?![\w-])", text, re.I):
            out.append((kind, m.group(0), m.start()))
    return out


def closed_class_spans(text):
    out = gazetteer(text, APPS, "app") + gazetteer(text, SITES, "website") + gazetteer(text, SETTINGS, "setting")
    out += [("file", m.group(0), m.start()) for m in FILE_EXT.finditer(text)]
    if not FILE_EXT.search(text):
        out += [("file", m.group(0), m.start()) for m in FILE_NP.finditer(text)]
    out += [("folder", m.group(1), m.start(1)) for m in FOLDER_NP.finditer(text)]
    m = MSG_AFTER.search(text) or MSG_AFTER_APP.search(text)
    if m and re.search(r"\b(?:tell|message|ping|text|whatsapp|mail|email|reply|say|let)\b", text, re.I):
        out.append(("message", m.group(1), m.start(1)))
    return out


# ---------- sentence frames (verb patterns) ----------
EVENT_WORDS = r"(?:review|standup|stand-up|sync|lunch|dinner|appointment|interview|class|session|demo|retro|workshop|gym|yoga|1:1)"
FAMILY = ["mom", "mum", "mother", "dad", "father", "bhai", "didi", "boss", "manager", "hr", "wife", "husband"]
NOT_NAME = {"me", "my", "it", "this", "that", "these", "those", "the", "a", "an", "all", "everyone", "us", "him", "her", "them",
            "everything", "something", "anything", "new", "latest"}
LEAD = r"^(?:(?:pls|please|yo|hey|can you|can u|could you|lemme|gimme)\s+)*"
APPRX = "(?:" + "|".join(map(re.escape, APPS + SITES)) + ")"
TALK = re.compile(LEAD + r"(tell|message|msg|ping|text|ask|dm|notify)\s+(?:(?:the|my)\s+)?([\w'.-]+(?:\s+(?:team|channel|group|chat))?)"
                  rf"(?:\s+on\s+({APPRX}))?\s+(.+?)\s*[.?!]*$", re.I)
MAIL = re.compile(LEAD + r"(email|mail|forward)\s+([\w'.-]+)\s+(?:(?:that|saying|:)\s+)?(.+?)\s*[.?!]*$", re.I)
POST = re.compile(LEAD + r"post\s+(.+?)\s+(?:in|to|on)\s+((?:the\s+)?[\w-]+\s+(?:channel|group|chat))\s*[.?!]*$", re.I)
GROUP = re.compile(r"\b(?:the\s+)?(?!the\b)([\w-]+\s+(?:team|channel|group|chat))\b", re.I)
FREE = re.compile(r"\b(?:is|are|does)\s+([\w'-]+)(?:\s+and\s+i)?\s+(?:get\s+)?free\b", re.I)
PLAY = re.compile(LEAD + r"(?:play|put on)\s+(?:(?:some|me)\s+)?(.+?)(?:\s+on\s+" + APPRX + r"|'s\b.*|\s+songs?\b.*|\s+music\b.*)?\s*[.?!]*$", re.I)
CREATOR = [re.compile(r"\b([\w.]+(?:\s[\w.]+)?)'s\s+(?:latest|newest|new)\s+(?:\w+\s+)?vid", re.I),
           re.compile(r"\bnew\s+(\w+)\s+vid", re.I), re.compile(r"\bvideos?\s+(?:from|by)\s+(\w+)", re.I)]
SEARCH = re.compile(rf"\bsearch(?:\s+{APPRX})?\s+for\s+(.+?)\s*[.?!]*$", re.I)
ABOUT = re.compile(rf"\b(?:emails?|mails?|messages?)\b.*?\babout\s+(.+?)(?=\s+(?:from|since|of|on)\s+(?:{DAY}|last|this|next|\d)|\s*[.?!]*$)", re.I)
REMIND = re.compile(rf"\bremind\s+me\s+(?:to|about|abt)\s+(.+?)(?=\s+(?:at|in|on|by|{DAY})\b|\s*[.?!]*$)", re.I)
ADD_EV = re.compile(r"\b(?:add|put|schedule)\s+(?:(?:an?|my)\s+)?(.+?)(?=\s+(?:on|for|in|at|to)\s+(?:my\s+)?(?:calendar|\w+day|\d)|\s+(?:on|for|at|in|tomorrow|today|tmrw|next|this)\b|\s*[.?!]*$)", re.I)
BLOCK_FOR = re.compile(r"\bblock\b.*?\bfor\s+(.+?)\s*[.?!]*$", re.I)
CHG_EV = re.compile(r"\b(?:decline|cancel|skip|move|push|reschedule)\s+(?:the|my)\s+(.+?)(?=\s+(?:on|to|for|from|at)\b|\s+(?:today|tomorrow|tmrw)\b|\s*[.?!]*$)", re.I)
NUM_TO = re.compile(rf"\b(?:{'|'.join(map(re.escape, SETTINGS))})\s+to\s+(\d{{1,3}})\b", re.I)


def frame_spans(text):
    """Higher-priority spans found from the sentence shape. Returns (kind, text, start, end)."""
    out = []

    def add(kind, m, g=1):
        if m and m.group(g) and m.group(g).strip():
            out.append((kind, m.group(g), m.start(g), m.end(g)))

    m = TALK.match(text)
    if m and m.group(2).lower() not in NOT_NAME:
        add("contact", m, 2)
        add("message", m, 4)
        rest = re.sub(r"^(?:that|to)\s+", "", m.group(4), flags=re.I)
        if rest != m.group(4):
            out.pop()
            out.append(("message", rest, m.end(4) - len(rest), m.end(4)))
    else:
        m = MAIL.match(text)
        if m and m.group(2).lower() not in NOT_NAME and not re.search(FILE_NOUN + r"$", m.group(2), re.I) \
                and "." not in m.group(2) and not FILE_NP.search(m.group(3)) and not FILE_EXT.search(m.group(3)) \
                and m.group(1).lower() != "forward":
            add("contact", m, 2)
            if not re.match(r"(?:to|from|with)\b", m.group(3), re.I) and not DATE_RE.fullmatch(m.group(3)):
                add("message", m, 3)
    m = POST.match(text)
    if m:
        add("message", m, 1)
        add("contact", m, 2)
    for m in GROUP.finditer(text):
        add("contact", m)
    for m in FREE.finditer(text):
        if m.group(1).lower() not in NOT_NAME | {"i", "there", "anyone", "somebody"}:
            add("contact", m)
    for w in FAMILY:
        for m in re.finditer(rf"(?<![\w-]){w}(?![\w-])", text, re.I):
            if not any(o[0] == "contact" and o[2] <= m.start() < o[3] for o in out):
                out.append(("contact", m.group(0), m.start(), m.end()))
    m = PLAY.match(text)
    if m and m.group(1).lower() not in {"the music", "music", "something", "it", "songs", "a song", "my focus playlist"} \
            and not re.fullmatch(APPRX, m.group(1), re.I):
        add("media", m)
    for rx in CREATOR:
        for m in rx.finditer(text):
            if not any(o[0] == "media" for o in out) and m.group(1).lower() not in {"the", "my", "this", "that", "his", "her"}:
                add("media", m)
    m = SEARCH.search(text) or ABOUT.search(text)
    add("query", m)
    m = REMIND.search(text)
    if m and not re.match(rf"(?:{DAY}|\d)", m.group(1), re.I):
        add("message", m)
    # events
    for rx in (ADD_EV, BLOCK_FOR, CHG_EV):
        m = rx.search(text)
        if not m:
            continue
        x = m.group(1)
        a, b = m.start(1), m.end(1)
        x2 = re.sub(r"\s+(?:in|on|to)\s+my\s+calendar$", "", x, flags=re.I)
        b -= len(x) - len(x2)
        x = x2
        lead = re.match(rf"(?:(?:the|my|a|an)\s+)?(?:(?:{TIME}|{DAY})\s+)*", x, re.I)
        a += lead.end()
        x = x[lead.end():]
        if not x or re.match(rf"(?:this|that|these|it|one|{NUMW}|\d)\b", x, re.I):
            continue
        if rx is CHG_EV and not re.search(EVENT_WORDS + r"$", x, re.I):
            continue
        if re.fullmatch(r"(?:meeting|call|event|invite|reminder|alarm|timer|appointment|meetings|\w+\s+(?:meeting|call|invite))s?", x, re.I) or \
                re.match(r"(?:meeting|call|event)\b", x, re.I):
            continue
        out.append(("event", x, a, a + len(x)))
        break
    m = NUM_TO.search(text)
    add("number", m)
    return out


def rule_spans(text):
    out, taken = [], []

    def add(kind, rx):
        for m in rx.finditer(text):
            if any(m.start() < e and s < m.end() for s, e in taken):
                continue
            taken.append((m.start(), m.end()))
            out.append((kind, m.group(0), m.start()))

    add("duration", DUR_RE)
    add("date_time", DATE_RE)
    add("number", NUM_RE)
    return out


# ---------- model ----------

LABELS = {
    "a": {
        "app": "application", "contact": "person or group", "file": "file or document", "folder": "folder",
        "media": "song, artist or video creator", "website": "website", "query": "search query",
        "message": "message text", "place": "place", "event": "meeting or event", "setting": "system setting",
    },
    "b": {
        "app": "app name", "contact": "contact name", "file": "file name", "folder": "folder name",
        "media": "music artist or youtuber", "website": "website name", "query": "search topic",
        "message": "message to send", "place": "city or country", "event": "calendar event", "setting": "device setting",
    },
}
RULE_TYPES = {"date_time", "duration", "number"}
CLOSED = {"app", "website", "setting", "folder"}


_CACHE_LOADED = {}  # raw GLiNER outputs at threshold 0.3 (see dump.py); --live bypasses the cache


class Extractor:
    def __init__(self, model, labels, threshold, rules=True):
        self.name = model
        self.model = None
        if model not in _CACHE_LOADED:
            import pickle
            p = ROOT / "data" / f"raw_{model.split('/')[1]}.pkl"
            _CACHE_LOADED[model] = pickle.load(open(p, "rb")) if p.exists() and "--live" not in sys.argv else {}
        self.labels, self.rev = labels, {v: k for k, v in labels.items()}
        self.threshold, self.rules = threshold, rules

    def extract(self, text):
        out = []
        raw = _CACHE_LOADED[self.name].get((self.name, text)) if self.labels is LABELS["a"] else None
        if raw is None:
            if self.model is None:
                from gliner import GLiNER
                self.model = GLiNER.from_pretrained(self.name)
            raw = self.model.predict_entities(text, list(self.labels.values()), threshold=self.threshold)
        for e in [e for e in raw if e["score"] >= self.threshold]:
            kind = self.rev[e["label"]]
            if self.rules and kind in RULE_TYPES | CLOSED:
                continue
            out.append((kind, e["text"], e["start"], e["end"]))
        if self.rules:
            fixed = [(k, t, s, s + len(t)) for k, t, s in closed_class_spans(text)]
            fixed += [(k, t, s, s + len(t)) for k, t, s in rule_spans(text)]
            frames_ = frame_spans(text)
            prot = [f for f in frames_ if f[0] in ("message", "query", "event")]
            fixed = [f for f in fixed if not any(p[2] <= f[2] and f[3] <= p[3] for p in prot)]
            # a file span is dropped when it sits inside a folder span ("the Invoices folder")
            fixed = [f for f in fixed if not (f[0] == "file" and any(g[0] == "folder" and g[2] <= f[2] and f[3] <= g[3] + 7 and g[2] - 8 <= f[2] for g in fixed))]
            fixed = [f for f in fixed if not any(f[2] < g[3] and g[2] < f[3] and g[0] != f[0] for g in frames_)]
            fixed += frames_
            kept = [o for o in out if not any(o[2] < f[3] and f[2] < o[3] for f in fixed)]
            out = kept + fixed
            # a capitalised word after to/into is a folder only if nothing else claimed it
            for m in (FOLDER_CAP.finditer(text) if re.search(r"\b(?:move|save|copy|put|drop|store)\b", text, re.I) else []):
                s0, e0 = m.start(1), m.end(1)
                if not any(s0 < o[3] and o[2] < e0 for o in out):
                    out.append(("folder", m.group(1), s0, e0))
        seen, res = set(), []
        for k, t, s, e in out:
            if len(t.strip()) < 2:
                continue
            if (k, norm(t)) not in seen:
                seen.add((k, norm(t)))
                res.append((k, t))
        return res


def score(ex, rows, show=False):
    tp = fp = fn = perfect = 0
    per = {k: Counter() for k in set(LABELS["a"]) | RULE_TYPES}
    for rid, text, gold in rows:
        pred = Counter((k, norm(t)) for k, t in ex.extract(text))
        want = Counter((k, norm(t)) for k, t in gold)
        hit = pred & want
        n_tp, n_fp, n_fn = sum(hit.values()), sum((pred - want).values()), sum((want - pred).values())
        tp, fp, fn = tp + n_tp, fp + n_fp, fn + n_fn
        perfect += n_fp == 0 and n_fn == 0
        for (k, _), c in hit.items():
            per[k]["tp"] += c
        for (k, _), c in (pred - want).items():
            per[k]["fp"] += c
        for (k, _), c in (want - pred).items():
            per[k]["fn"] += c
        if show and (n_fp or n_fn):
            print(f"  {rid} {text!r}\n      missed {sorted((want - pred).elements())}  extra {sorted((pred - want).elements())}")
    p, r = tp / max(tp + fp, 1), tp / max(tp + fn, 1)
    f1 = 2 * p * r / max(p + r, 1e-9)
    return dict(tp=tp, fp=fp, fn=fn, p=p, r=r, f1=f1, perfect=perfect, n=len(rows), per=per)


def confusion(ex, rows):
    """Rows = real span type, columns = predicted type. MISSED = nothing found, EXTRA = found but not real."""
    M = Counter()
    for _, text, gold in rows:
        pred = [(k, norm(t)) for k, t in ex.extract(text)]
        used = set()
        for k, t in gold:
            n = norm(t)
            hit = next((i for i, (pk, pt) in enumerate(pred) if i not in used and pt == n and pk == k), None)
            if hit is None:
                hit = next((i for i, (pk, pt) in enumerate(pred) if i not in used and pt == n), None)
            if hit is None:
                M[(k, "MISSED")] += 1
            else:
                used.add(hit)
                M[(k, pred[hit][0])] += 1
        for i, (pk, _) in enumerate(pred):
            if i not in used:
                M[("EXTRA", pk)] += 1
    kinds = sorted({k for k, _ in M} | {k for _, k in M} - {"MISSED", "EXTRA"})
    rows_ = [k for k in kinds if k != "MISSED"] + (["EXTRA"] if any(r == "EXTRA" for r, _ in M) else [])
    rows_ = [r for r in dict.fromkeys(rows_) if r != "MISSED"]
    cols = [k for k in kinds if k not in ("EXTRA", "MISSED")] + ["MISSED"]
    print("real \\ predicted".ljust(14) + "".join(c[:7].rjust(8) for c in cols))
    for r in rows_:
        if sum(M[(r, c)] for c in cols) == 0:
            continue
        print(r.ljust(14) + "".join(str(M[(r, c)] or ".").rjust(8) for c in cols))


def fmt(name, s):
    return (f"{name:34s} TP {s['tp']:3d} FP {s['fp']:3d} FN {s['fn']:3d}  precision {s['p']:.0%} recall {s['r']:.0%} "
            f"F1 {s['f1']:.0%}   every span right in {s['perfect']}/{s['n']} sentences")


def main():
    val, doc4 = load("val.txt"), load("doc4.txt")
    models = ["urchade/gliner_small-v2.1"]  # medium + label set b were worse on val in the first live sweep (see RESULT.md)
    best = None
    for m in models:
        for lab in "a":
            for th in (0.3, 0.5, 0.7):
                ex = Extractor(m, LABELS[lab], th)
                s = score(ex, val)
                print(fmt(f"val {m.split('/')[1]} {lab} {th}", s))
                if best is None or s["f1"] > best[0]["f1"]:
                    best = (s, m, lab, th)
    s, m, lab, th = best
    print(f"\nchosen on val: {m} labels={lab} threshold={th}\n")
    ex = Extractor(m, LABELS[lab], th)
    print(fmt("val (rules + GLiNER)", score(ex, val)))
    print(fmt("val (GLiNER only)", score(Extractor(m, LABELS[lab], th, rules=False), val)))
    if "--dev" in sys.argv:
        score(ex, val, show=True)
        return
    t = score(ex, doc4, show=True)
    print()
    print(fmt("DOC4 T01-T64 (rules + GLiNER)", t))
    print(fmt("DOC4 T01-T64 (GLiNER only)", score(Extractor(m, LABELS[lab], th, rules=False), doc4)))
    print("\nper type on doc4:")
    for k, c in sorted(t["per"].items()):
        if sum(c.values()):
            print(f"  {k:10s} TP {c['tp']:2d} FP {c['fp']:2d} FN {c['fn']:2d}")
    print("\nconfusion matrix on doc4 (counts of spans):")
    confusion(ex, doc4)
    if "--final" in sys.argv:
        test = load("test.txt")
        ts = score(ex, test, show=True)
        print()
        print(fmt("HELD-OUT TEST (rules + GLiNER)", ts))
        print(fmt("HELD-OUT TEST (GLiNER only)", score(Extractor(m, LABELS[lab], th, rules=False), test)))
        comb = doc4 + test
        print(fmt("COMBINED doc4+test", score(ex, comb)))
    # live latency / memory: bypass the cache and run the model for real
    import torch
    torch.set_num_threads(4)
    _CACHE_LOADED[m] = {}
    ex = Extractor(m, LABELS[lab], th)
    lat = []
    for _, text, _ in doc4:
        t0 = time.perf_counter()
        ex.extract(text)
        lat.append((time.perf_counter() - t0) * 1000)
    lat.sort()
    print(f"\nlive, 4 threads: mean {sum(lat) / len(lat):.0f} ms, median {lat[len(lat) // 2]:.0f} ms, p95 {lat[int(len(lat) * .95)]:.0f} ms per request")
    print(f"peak RSS {psutil.Process().memory_info().rss / 1e6:.0f} MB")


if __name__ == "__main__":
    main()
